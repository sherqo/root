---
import { links } from '../lib/links';

export function getStaticPaths() {
  // Generate all possible static paths from links
  const paths: Array<{ params: { slug: string | string[] } }> = [];

  // Add single-segment paths for all links
  Object.keys(links).forEach(slug => {
    paths.push({
      params: { slug },
    });
  });

  return paths;
}

const { slug } = Astro.params;

let target: string | undefined;

if (Array.isArray(slug)) {
  const [baseSlug, ...subParts] = slug;
  const baseUrl = links[baseSlug];

  if (baseUrl) {
    target = subParts.length > 0 ? `${baseUrl}/${subParts.join('/')}` : baseUrl;
  }
} else {
  target = links[slug];
}

if (!target) {
  return Astro.redirect('/404');
}
---

<!doctype html>
<html>
  <head>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
  </head>
</html>
