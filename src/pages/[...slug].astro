---
// src/pages/[...slug].astro
import { links } from '../lib/links';

export interface PathParams {
  params: {
    slug: string;
  };
}

export function getStaticPaths(): PathParams[] {
  const paths: PathParams[] = [];

  // Add base single-segment links
  Object.keys(links).forEach((slug: string) => {
    paths.push({
      params: { slug },
    });
  });

  // Add multi-segment sub-paths
  const githubRepos: string[] = ['root'];
  githubRepos.forEach((repo: string) => {
    paths.push({
      params: { slug: `gh/${repo}` },
    });
  });

  return paths;
}

const { slug } = Astro.params as { slug: string };

const segments: string[] = slug.split('/');
const baseSlug: string = segments[0];
const baseUrl: string = links[baseSlug];

const subParts: string[] = segments.slice(1);
const target: string = subParts.length > 0 ? `${baseUrl}/${subParts.join('/')}` : baseUrl;
---

<!doctype html>
<html>
  <head>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
  </head>
</html>
