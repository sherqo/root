---
import { links } from '../lib/links';

export interface PathParams {
  params: {
    slug: string;
  };
}

export function getStaticPaths(): PathParams[] {
  const paths: PathParams[] = [];

  // Add base single-segment links
  Object.keys(links).forEach((slug: string) => {
    paths.push({
      params: { slug },
    });
  });

  // Add multi-segment sub-paths
  const githubRepos: string[] = ['root'];
  githubRepos.forEach((repo: string) => {
    paths.push({
      params: { slug: `gh/${repo}` },
    });
  });

  return paths;
}

const { slug } = Astro.params as { slug?: string };

let target: string | undefined;

if (slug) {
  const segments: string[] = slug.split('/');
  const baseSlug: string = segments[0];
  const baseUrl: string | undefined = links[baseSlug];

  if (baseUrl) {
    const subParts: string[] = segments.slice(1);
    target = subParts.length > 0 ? `${baseUrl}/${subParts.join('/')}` : baseUrl;
  }
}

if (!target) {
  return Astro.redirect('/404');
}
---

<!doctype html>
<html>
  <head>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
  </head>
</html>
