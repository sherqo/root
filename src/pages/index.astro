---
import { getCollection } from 'astro:content';
import PageLayout from '@/components/layouts/PageLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import type { Journal } from '@/lib/journal.type';

const journals = await getCollection('journal');
const rootJournals = journals.filter((j: Journal) => !j.id.includes('/') || j.id.endsWith('/index'));
const sortedJournals = rootJournals.sort((a: Journal, b: Journal) => b.data.date.getTime() - a.data.date.getTime());
const dateFormatter = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const getJournalSlug = (journal: Journal) => {
  const rawSlug = ('slug' in journal ? journal.slug : journal.id) ?? '';
  return rawSlug.endsWith('/index') ? rawSlug.slice(0, -6) : rawSlug;
};
---

{/* HOME PAGE '/' */}
<PageLayout title="Home" description="Sharqawy — CS student, builder, and maker. Read my journal.">
  <div class="space-y-16">
    <PageHeader>Sharqawy Wael</PageHeader>

    <div class="space-y-6">
      <p>
        I'm a Computer Engineering student, and this is my public space to share my work, thoughts, and everything I'm figuring out along
        the way. My résumé is
        <a href="/resume" target="_blank" rel="noopener noreferrer"> available </a>.
      </p>
    </div>

    <div>
      <div class="bg-border my-12 h-px"></div>
      {
        sortedJournals.length === 0 ? (
          <p>No posts yet.</p>
        ) : (
          <div class="not-prose flex flex-col leading-7">
            {sortedJournals.map((journal: Journal) => (
              <a
                href={`/journal/${getJournalSlug(journal)}`}
                class="text-foreground hover:text-primary focus:text-primary block truncate py-0.5! no-underline hover:underline focus:underline">
                <time datetime={journal.data.date.toISOString()}>{dateFormatter.format(journal.data.date)}</time> - {journal.data.title}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</PageLayout>
