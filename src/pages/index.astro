---
import PageLayout from '@/components/PageLayout.astro';

const siteUrl = Astro.url.origin;
---

<PageLayout
  description="Sharqawy Wael, known as Sherqo and sharqawycs online, is a software engineer and systems builder focused on distributed systems and developer tools."
  structuredData={{
    '@context': 'https://schema.org',
    '@type': ['ProfilePage', 'WebSite'],
    '@id': `${siteUrl}/#website`,
    url: siteUrl,
    name: 'Sharqawy Wael (Sherqo) - sharqawycs',
    description: 'Personal site and technical journal by Sharqawy Wael.',
    mainEntity: { '@id': `${siteUrl}/#person` },
  }}>
  <header>
    <h1 class="font-semibold">Yo, I'm Sharqawy <span class="sr-only">Wael</span> (aka Sherqo)<span class="sr-only"> - sharqawycs</span></h1>
    <p class="mt-0.75">
      I love building <a href="/journal/software">software</a>, understanding how things work, and writing about what I learn. I'm currently
      doing my <a href="journal/bachelor">bachelor's</a> in Computer &amp AI Engineering, with a minor in Distributed Systems.
    </p>
  </header>

  <section class="mt-5" aria-labelledby="work-heading">
    <h2 id="work-heading" class="text-muted">Stuff I've worked on...</h2>
    <div class="mt-1 grid gap-4 leading-[1.3]">
      <p>
        – I interned at <a href="/journal/siemens">Siemens EDA</a>, building highly scalable internal tooling for hardware verification
        workflows.
      </p>
      <p>– <a href="/journal/yaleeq">Yaleeq</a>, an internship-finding platform, built by students for students.</p>
      <p>
        – I built <a href="https://github.com/sherqo/raft" target="_blank" rel="noopener noreferrer">Raft</a>, an implementation of the
        distributed consensus algorithm.
      </p>
    </div>
  </section>

  <section class="mt-8" aria-labelledby="journal-heading">
    <p id="journal-heading">I also write some <a href="/journal">stuff</a>.</p>
  </section>
</PageLayout>
