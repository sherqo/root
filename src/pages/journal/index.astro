---
import { getCollection } from 'astro:content';
import PageLayout from '@/components/layouts/PageLayout.astro';
import PageHeader from '@/components/PageHeader.astro';

const journals = (await getCollection('journal'))
  .filter(journal => !journal.data.hidden)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const dateFormatter = new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<PageLayout title="Journal" description="Writing about software, systems, and things I'm figuring out.">
  <PageHeader subtitle="Some writing about software, systems, and things I'm figuring out.">Journal</PageHeader>

  <div
    class="[&_time]:text-muted [&_a:hover_time]:text-primary mt-8 grid gap-1 [&_a]:no-underline [&_a:focus-visible]:underline [&_a:hover]:underline">
    {
      journals.map(journal => (
        <a href={`/journal/${journal.id}`}>
          <time datetime={journal.data.date.toISOString()}>{dateFormatter.format(journal.data.date)}</time> - {journal.data.title}
        </a>
      ))
    }
  </div>
</PageLayout>
