<button
  id="tt"
  class="hover:text-primary text-foreground cursor-pointer no-underline before:opacity-60 before:content-['['] after:opacity-60 after:content-[']'] hover:underline"
  aria-label="Theme toggle button"><span id="tt-text">Dark</span></button
>

<script is:inline>
  function initThemeToggle() {
    const b = document.getElementById('tt');
    const s = document.getElementById('tt-text');
    if (!b || !s || b.dataset.init === '1') return;
    b.dataset.init = '1';
    let d = localStorage.t !== 'l';
    const u = function () {
      document.documentElement.classList.toggle('dark', d);
      s.textContent = d ? 'dark' : 'light';
    };
    b.onclick = function () {
      d = !d;
      localStorage.t = d ? 'd' : 'l';
      u();
    };
    u();
  }
  document.addEventListener('astro:page-load', initThemeToggle);
  initThemeToggle();
</script>
