---
import type { ImageMetadata } from 'astro';
import Image from './Image.astro';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  class?: string;
}

const { images, class: className } = Astro.props;
const layout = images.length === 3 ? 'image-collage--three' : 'image-collage--grid';
---

<div class:list={['image-collage', layout, className]}>
  {images.map(image => <Image src={image.src} alt={image.alt} />)}
</div>

<style>
  .image-collage {
    display: grid;
    gap: 0.75rem;
  }

  .image-collage--three {
    grid-template-rows: repeat(2, minmax(0, 1fr));
    grid-template-columns: 1.35fr 1fr;
    aspect-ratio: 1.5;
  }

  .image-collage--three :global(a:first-child) {
    grid-row: 1 / span 2;
  }

  .image-collage--grid {
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  .image-collage :global(a) {
    height: 100%;
    min-height: 0;
    overflow: hidden;
  }

  .image-collage :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 480px) {
    .image-collage--three {
      grid-template-rows: auto auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      aspect-ratio: auto;
    }

    .image-collage--three :global(a:first-child) {
      grid-row: auto;
      grid-column: 1 / -1;
      aspect-ratio: 16 / 9;
    }
  }
</style>
