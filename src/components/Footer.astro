---
import ThemeToggler from './ThemeToggler.astro';
import { links } from '@/lib/links';
const mail = 'hi@sherqo.me';
---

<footer
  id="footer"
  aria-label="Social links"
  class="mt-16 flex flex-nowrap items-center gap-x-3 overflow-hidden text-sm whitespace-nowrap [&_a]:no-underline [&_a::after]:opacity-60 [&_a::after]:content-[']'] [&_a::before]:opacity-60 [&_a::before]:content-['['] [&_a:hover]:underline">
  {Astro.url.pathname !== '/' && <a href="/">home</a>}
  <a href={`mailto:${mail}`}>{mail}</a>

  <a href={links['github']} id="d-git" target="_blank" rel="noopener noreferrer">github</a>
  <a href={links['x']} id="d-x" target="_blank" rel="noopener noreferrer">x</a>
  <a href={links['resume']} id="d-resume" target="_blank" rel="noopener noreferrer">resume</a>
  <a href={links['linkedin']} id="d-in" target="_blank" rel="noopener noreferrer">linkedin</a>

  <ThemeToggler />
</footer>

<script is:inline>
  let footerObserver;
  function initFooterOverflow() {
    const nav = document.getElementById('footer');
    if (!nav) return;
    if (footerObserver) footerObserver.disconnect();
    const dropOrder = ['d-yt', 'd-in', 'd-x', 'd-resume', 'd-git'].map(id => document.getElementById(id));

    const update = () => {
      dropOrder.forEach(el => el && (el.style.display = ''));
      for (let el of dropOrder) {
        if (nav.scrollWidth > nav.clientWidth && el) el.style.display = 'none';
      }
    };
    update();
    footerObserver = new ResizeObserver(update);
    if (nav.parentElement) footerObserver.observe(nav.parentElement);
  }
  document.addEventListener('astro:page-load', initFooterOverflow);
  initFooterOverflow();
</script>
