---
// The Root Layout with all global rules
import '@/global.css';
import { ClientRouter } from 'astro:transitions';
import Font from 'astro/components/Font.astro';
import Footer from './Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const env = import.meta.env;
const identity = 'Sharqawy Wael (Sherqo) - sharqawycs';
const siteUrl = Astro.url.origin;

let {
  title,
  description = env.PUBLIC_DEFAULT_DESCRIPTION,
  ogImage = Astro.url.origin + env.PUBLIC_OG_IMAGE,
  noindex = false,
  structuredData,
} = Astro.props as Props;

title = title ? `${title} | ${identity}` : identity;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: 'Sharqawy Wael',
  alternateName: ['Sherqo', 'sharqawycs'],
  url: siteUrl,
  jobTitle: 'Software Engineer and Systems Builder',
  description,
  sameAs: [
    'https://github.com/sherqo',
    'https://x.com/sharqawycs',
    'https://youtube.com/@sharqawycs',
    'https://linkedin.com/in/sharqawycs',
  ],
  knowsAbout: ['Software engineering', 'Distributed systems', 'Developer tools', 'Computer engineering', 'Backend Development'],
};

const schemas = [person, ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [])];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <Font cssVariable="--font-inter" preload />
    <meta charset="UTF-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <link rel="canonical" href={Astro.url} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={Astro.url} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
    <ClientRouter />
    <script type="speculationrules">
      {
        "prerender": [
          {
            "source": "document",
            "where": {
              "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/_astro/*" } }]
            },
            "eagerness": "eager"
          }
        ]
      }
    </script>
  </head>

  <body
    class="font-primary text-foreground bg-background mx-auto my-34 max-w-xl text-base leading-[1.7] antialiased max-[672px]:my-12 max-[608px]:mx-4">
    <slot />
    <Footer />
  </body>
</html>
