---
import RootLayout from '@/components/layouts/RootLayout.astro';
import Footer from '@/components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  footer?: boolean;
}

const { title, description, ogImage, noindex, footer = true } = Astro.props as Props;
---

<RootLayout title={title} description={description} ogImage={ogImage} noindex={noindex}>
  <div class="site-container">
    <main>
      <slot />
    </main>
    {footer && <Footer />}
  </div>
</RootLayout>

<style>
  .site-container {
    box-sizing: border-box;
    margin: 96px auto 64px;
    padding: 0 16px;
    width: 100%;
    max-width: 680px;
  }

  .site-container main {
    margin-bottom: 64px;
  }

  @media (max-width: 720px) {
    .site-container {
      margin-top: 48px;
    }
  }
</style>
