---
import RootLayout from '@/components/layouts/RootLayout.astro';
import { cn } from '@/lib/utils';
import Footer from '@/components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  footer?: boolean;
  class?: string;
}

const { title, description, ogImage, noindex, footer = true, class: className = '' } = Astro.props as Props;
---

<RootLayout title={title} description={description} ogImage={ogImage} noindex={noindex}>
  <main class={cn('flex-1 w-full', !className && 'p-4 max-w-3xl mx-auto', className)}>
    <slot />
  </main>
  {footer && <Footer />}
</RootLayout>
