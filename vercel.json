{
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff2|woff|css|js|png|jpg|jpeg|webp|avif|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/blog", "destination": "/journal", "permanent": true },
    { "source": "/cv", "destination": "https://resume.sherqo.me/Sharqawy_Wael_Resume.pdf", "permanent": true },
    { "source": "/resume", "destination": "https://resume.sherqo.me/Sharqawy_Wael_Resume.pdf", "permanent": true },
    { "source": "/github", "destination": "https://github.com/sherqo", "permanent": true },
    { "source": "/gh", "destination": "https://github.com/sherqo", "permanent": true },
    { "source": "/x", "destination": "https://x.com/sharqawycs", "permanent": true },
    { "source": "/twitter", "destination": "https://x.com/sharqawycs", "permanent": true },
    { "source": "/youtube", "destination": "https://youtube.com/@sharqawycs", "permanent": true },
    { "source": "/yt", "destination": "https://youtube.com/@sharqawycs", "permanent": true },
    { "source": "/linkedin", "destination": "https://linkedin.com/in/sharqawycs", "permanent": true },
    { "source": "/li", "destination": "https://linkedin.com/in/sharqawycs", "permanent": true },
    { "source": "/in", "destination": "https://linkedin.com/in/sharqawycs", "permanent": true },
